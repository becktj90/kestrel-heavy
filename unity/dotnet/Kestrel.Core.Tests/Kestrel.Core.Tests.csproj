<!-- dotnet test runner for the same NUnit EditMode test files Unity runs. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- dotnet-only: exhaustive sweeps too slow for Unity's EditMode runner (180 s per test). Not in the asmdef. -->
    <DefineConstants>$(DefineConstants);KH_DOTNET_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Kestrel.Core.Tests/**/*.cs" LinkBase="Kestrel.Core.Tests" />
    <Compile Include="../../Assets/Kestrel.Slice/Runtime/Report/ReportLayout.cs" Link="ReportLayout.cs" />
    <Compile Include="ReportFixture.cs" />
    <Compile Include="PostFlightCardTests.cs" />
    <ProjectReference Include="../Kestrel.Core/Kestrel.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
