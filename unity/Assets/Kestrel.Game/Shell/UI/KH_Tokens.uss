/* Kestrel Heavy UI tokens (U2). Units are SE points: the shell PanelSettings use
   Scale With Screen Size (375x667 ref, match height), so 1 USS px = 1 pt on SE and scales up on Pro Max / iPad.
   Spacing/touch values come from docs/VISUAL_SPEC.md §5 (sideMarginPt 8, minTouchPt 44).
   Colours: livery defaults from web/js/vehicle/design.js (#f2f2f2 / #1a3c6e) and the noon wash in
   data/tod.json. Art owns final palette/typography (plan §4); change tokens here, not per screen. */

:root {
    --kh-space-1: 4px;
    --kh-space-2: 8px;            /* = sideMarginPt */
    --kh-space-3: 12px;
    --kh-space-4: 16px;
    --kh-space-6: 24px;
    --kh-home-navy: #1e2e48;      /* HomeArt.Navy (mix-v2) */
    --kh-home-cream: #faf0d7;     /* HomeArt.Cream */
    --kh-home-orange: #e88c3c;    /* HomeArt.SunOuter */
    --kh-home-red: #c8102e;
    --kh-home-console: #3c342e;   /* HomeArt.Console */
    --kh-home-lamp-on: #7ee08a;
    --kh-home-lamp-off: #6b5f55;
    --kh-touch-min: 44px;         /* = minTouchPt */
    --kh-radius: 10px;

    --kh-color-ink: #f2f2f2;      /* livery.primary default */
    --kh-color-accent: #1a3c6e;   /* livery.accent default */
    --kh-color-accent-hi: #2a5a8c;/* noon wash.near */
    --kh-color-sky: #6fb4e8;      /* noon wash.horizon */
    --kh-color-space: #010105;    /* noon wash.space */
    --kh-color-panel: rgba(1, 1, 5, 0.62);
    --kh-color-warn: #f6c888;
    --kh-color-danger: #c45a48;

    --kh-font-title: 28px;
    --kh-font-body: 17px;         /* iOS body */
    --kh-font-caption: 13px;
}

.kh-root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0); /* themed fill shows through from the camera */
}

.kh-safe {
    /* position/insets are set from Screen.safeArea + 8 pt by SafeAreaRoot */
    flex-direction: column;
}

.kh-screen {
    flex-grow: 1;
    align-items: stretch;
    justify-content: center;
    padding: var(--kh-space-4);
    max-width: 600px;              /* iPad: keep a readable column, centred; fill stays edge to edge */
    width: 100%;
    align-self: center;
}

.kh-title {
    -unity-font-style: bold;
    font-size: var(--kh-font-title);
    color: var(--kh-color-ink);
    -unity-text-align: middle-center;
    margin-bottom: var(--kh-space-6);
    letter-spacing: 2px;
}

.kh-home { flex-grow: 1; justify-content: flex-start; align-items: center; padding: var(--kh-space-6) var(--kh-space-4) var(--kh-space-6) var(--kh-space-4); }
/* Title and subtitle stretch across the safe column (align-self beats the centered column).
   HomeTitleFit shrinks the 52px wordmark until KESTREL fits that width; the subtitle wraps. */
/* Outline stays off. A 1px UITK outline redrew every stroke and read as a doubled letter.
   The hangar wordmark is TextMeshPro with an SDF glow instead. */
.kh-home-title { font-size: 52px; -unity-font-style: bold; color: var(--kh-home-cream); -unity-text-align: middle-center; letter-spacing: 4px; margin-top: 32px; -unity-text-outline-width: 0; width: 100%; max-width: 100%; white-space: nowrap; align-self: stretch; }
.kh-home-title-rest { margin-top: 0; color: var(--kh-home-orange); }
.kh-home-subtitle { font-size: 15px; color: var(--kh-home-cream); letter-spacing: 3px; -unity-text-align: middle-center; margin-top: var(--kh-space-2); width: 100%; max-width: 100%; white-space: normal; align-self: stretch; }
.kh-subtitle { font-size: var(--kh-font-body); color: var(--kh-color-ink); -unity-text-align: middle-center; margin-bottom: var(--kh-space-6); }
.kh-button {
    min-height: var(--kh-touch-min);
    min-width: var(--kh-touch-min);
    margin: var(--kh-space-2) 0;
    padding: var(--kh-space-2) var(--kh-space-4);
    border-radius: var(--kh-radius);
    border-width: 0;
    background-color: var(--kh-color-accent);
    color: var(--kh-color-ink);
    font-size: var(--kh-font-body);
    -unity-font-style: bold;
}

/* Retro Home console (mix-v2). Two-class selectors so they outrank .kh-button above. Every target >= 44px. */
.kh-home-callout { font-size: 11px; color: var(--kh-home-cream); letter-spacing: 1px; }
.kh-home-grain { opacity: 0.5; }
.kh-home-console { width: 100%; max-width: 420px; align-self: center; background-color: var(--kh-home-console); border-top-width: 3px; border-top-color: var(--kh-home-orange); border-radius: var(--kh-radius); padding: var(--kh-space-3); margin-bottom: var(--kh-space-2); }
.kh-home-console-row { flex-direction: row; align-items: center; margin-bottom: var(--kh-space-3); }
.kh-home-patch { width: 76px; height: 76px; min-width: 76px; margin-right: var(--kh-space-3); justify-content: flex-end; align-items: center; }
.kh-home-patch-label { font-size: 11px; -unity-font-style: bold; color: var(--kh-home-cream); margin-bottom: 8px; }
.kh-button.kh-home-launch { flex-grow: 1; height: 72px; min-height: 72px; font-size: 28px; -unity-font-style: bold; letter-spacing: 4px; background-color: var(--kh-home-red); color: #ffffff; border-width: 3px; border-color: var(--kh-home-cream); border-radius: var(--kh-radius); }
.kh-home-console-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.kh-button.kh-home-console-button { width: 48.5%; height: 52px; min-height: 52px; margin-bottom: var(--kh-space-2); flex-direction: row; align-items: center; justify-content: center; font-size: 15px; -unity-font-style: bold; letter-spacing: 2px; background-color: var(--kh-home-navy); color: var(--kh-home-cream); border-width: 1px; border-color: rgba(250, 240, 215, 0.4); }
.kh-button.kh-home-console-button:disabled { opacity: 0.55; }
.kh-home-lamp { width: 10px; height: 10px; border-radius: 5px; margin-right: var(--kh-space-2); }
.kh-home-lamp--on { background-color: var(--kh-home-lamp-on); }
.kh-home-lamp--off { background-color: var(--kh-home-lamp-off); }


.kh-button:hover { background-color: var(--kh-color-accent-hi); }
.kh-button:active { background-color: var(--kh-color-accent-hi); scale: 0.98 0.98; }
.kh-button:focus { border-width: 2px; border-color: var(--kh-color-sky); }

.kh-panel {
    background-color: var(--kh-color-panel);
    border-radius: var(--kh-radius);
    padding: var(--kh-space-3);
}

.kh-caption { font-size: var(--kh-font-caption); color: var(--kh-color-ink); opacity: 0.8; }

/* ---- Main menu "mix" overlay (Trevor's pick: dusk title card + tiles + film-reel bars). Fonts: Fraunces + Space
   Grotesk (OFL, subset, Assets/Art/Fonts). No glow. Two-class selectors outrank .kh-button. Targets >= 44px. ---- */
.kh-mm { position: absolute; left: 0; right: 0; top: 0; bottom: 0; flex-direction: column; padding: 40px var(--kh-space-3) 34px var(--kh-space-3); }
.kh-mm-full { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.kh-mm-bar { position: absolute; left: 0; right: 0; height: 6%; background-color: #0a0c12; }
.kh-mm-bar-top { top: 0; border-bottom-width: 1px; border-bottom-color: rgba(250, 240, 215, 0.25); }
.kh-mm-bar-bottom { bottom: 0; border-top-width: 1px; border-top-color: rgba(250, 240, 215, 0.25); }
.kh-mm-anim { opacity: 0; translate: 0 24px; transition-property: opacity, translate; transition-duration: 0.45s; transition-timing-function: ease-out-cubic; }
.kh-mm-anim.kh-mm-in { opacity: 1; translate: 0 0; }
.kh-mm-reduce .kh-mm-anim { transition-duration: 0s; }
.kh-mm-title-card { align-items: stretch; margin-top: 0; }
.kh-mm-kestrel { -unity-font: url("project://database/Assets/Art/Fonts/Resources/KHFonts/Fraunces-Black.ttf?fileID=12800000&guid=c170e4aa0170491ca90007e515c3db3e&type=3"); font-size: 80px; color: var(--kh-home-cream); -unity-text-align: middle-center; white-space: nowrap; align-self: stretch; -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(20, 31, 52, 0.7); }
.kh-mm-rule-row { flex-direction: row; align-items: center; justify-content: center; margin-top: -4px; }
.kh-mm-rule { flex-grow: 1; height: 2px; background-color: var(--kh-home-orange); margin: 0 var(--kh-space-3); }
.kh-mm-heavy { -unity-font: url("project://database/Assets/Art/Fonts/Resources/KHFonts/SpaceGrotesk-Bold.ttf?fileID=12800000&guid=8d76cbbc81224bc2a01f5e17341dae63&type=3"); font-size: 22px; letter-spacing: 12px; color: var(--kh-home-orange); -unity-text-align: middle-center; }
.kh-mm-launch { flex-direction: row; align-items: center; justify-content: flex-start; min-height: 68px; padding: 10px var(--kh-space-4); margin: 0 0 var(--kh-space-2) 0; background-color: var(--kh-home-red); border-width: 3px; border-color: var(--kh-home-cream); border-radius: var(--kh-radius); }
.kh-mm-launch:hover { background-color: #d8213f; }
.kh-mm-launch:active { background-color: #a80c26; scale: 0.97 0.97; translate: 0 3px; }
.kh-mm-launch:focus { border-color: var(--kh-home-orange); }
.kh-mm-col { flex-grow: 1; flex-direction: column; margin-left: var(--kh-space-3); }
.kh-mm-launch-label { -unity-font: url("project://database/Assets/Art/Fonts/Resources/KHFonts/Fraunces-Black.ttf?fileID=12800000&guid=c170e4aa0170491ca90007e515c3db3e&type=3"); font-size: 30px; letter-spacing: 3px; color: #ffffff; -unity-text-align: middle-left; }
.kh-mm-launch-caption { -unity-font: url("project://database/Assets/Art/Fonts/Resources/KHFonts/SpaceGrotesk-Medium.ttf?fileID=12800000&guid=da73225191314e37b12604307d854801&type=3"); font-size: 14px; color: #ffe2d6; white-space: normal; -unity-text-align: middle-left; }
.kh-mm-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.kh-button.kh-mm-tile { width: 48.5%; min-height: 88px; margin: 0 0 var(--kh-space-2) 0; padding: var(--kh-space-3); flex-direction: column; align-items: stretch; justify-content: flex-start; background-color: #2e2626; border-width: 2px; border-color: rgba(110, 92, 76, 1); border-radius: var(--kh-radius); }
.kh-button.kh-mm-tile--focus { background-color: var(--kh-home-cream); border-color: var(--kh-home-orange); border-width: 3px; }
.kh-button.kh-mm-tile--focus:hover { background-color: #fff6e0; }
.kh-button.kh-mm-tile:active { scale: 0.97 0.97; translate: 0 3px; background-color: #e8dcc0; }
.kh-button.kh-mm-tile:focus { border-color: var(--kh-home-cream); }
.kh-button.kh-mm-tile:disabled { opacity: 0.8; }
.kh-mm-tile-head { flex-direction: row; align-items: center; justify-content: space-between; min-height: 24px; }
.kh-mm-tile-name { -unity-font: url("project://database/Assets/Art/Fonts/Resources/KHFonts/Fraunces-Bold.ttf?fileID=12800000&guid=9ff7f267923c419eb9c234ff08737b2f&type=3"); font-size: 22px; letter-spacing: 1px; color: var(--kh-home-cream); -unity-text-align: middle-left; flex-shrink: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.kh-mm-tile--focus .kh-mm-tile-name { color: var(--kh-home-navy); }
.kh-mm-tile--soon .kh-mm-tile-name { color: #9c9282; }
.kh-mm-tile-caption { overflow: hidden; -unity-font: url("project://database/Assets/Art/Fonts/Resources/KHFonts/SpaceGrotesk-Medium.ttf?fileID=12800000&guid=da73225191314e37b12604307d854801&type=3"); font-size: 14px; color: #d6c8b0; white-space: normal; margin-top: var(--kh-space-1); -unity-text-align: upper-left; }
.kh-mm-tile--focus .kh-mm-tile-caption { color: #50463c; }
.kh-mm-tile--soon .kh-mm-tile-caption { color: #928874; }
.kh-mm-soon { -unity-font: url("project://database/Assets/Art/Fonts/Resources/KHFonts/SpaceGrotesk-Bold.ttf?fileID=12800000&guid=8d76cbbc81224bc2a01f5e17341dae63&type=3"); font-size: 11px; letter-spacing: 2px; color: #a09682; border-width: 1px; border-color: #a09682; border-radius: 4px; padding: 1px 5px; margin-left: var(--kh-space-1); flex-shrink: 0; }
.kh-mm-lamp { width: 12px; height: 12px; min-width: 12px; border-radius: 6px; border-width: 2px; border-color: #14120f; margin-left: var(--kh-space-1); flex-shrink: 0; }
.kh-mm-lamp--on { background-color: var(--kh-home-lamp-on); }
.kh-mm .kh-home-grain { opacity: 0.3; }
.kh-mm-hint { position: absolute; left: 0; right: 0; bottom: 2px; -unity-font: url("project://database/Assets/Art/Fonts/Resources/KHFonts/SpaceGrotesk-Bold.ttf?fileID=12800000&guid=8d76cbbc81224bc2a01f5e17341dae63&type=3"); font-size: 11px; letter-spacing: 2px; color: #ece2c8; -unity-text-align: middle-center; }
/* Narrow phones (panel < 500 px): smaller type and padding so nothing clips; tiles stay >= 44 px. */
.kh-mm-narrow .kh-mm-launch { min-height: 60px; padding: 8px var(--kh-space-3); }
.kh-mm-narrow .kh-mm-launch-label { font-size: 26px; }
.kh-mm-narrow .kh-mm-launch-caption { font-size: 12px; }
.kh-mm-narrow .kh-button.kh-mm-tile { min-height: 76px; padding: 10px; }
.kh-mm-narrow .kh-mm-tile-name { font-size: 17px; letter-spacing: 0px; }
.kh-mm-narrow .kh-mm-tile-caption { font-size: 12px; }
.kh-mm-narrow .kh-mm-soon { font-size: 10px; letter-spacing: 1px; padding: 0 4px; }
.kh-mm-narrow .kh-mm-heavy { font-size: 18px; letter-spacing: 9px; }
