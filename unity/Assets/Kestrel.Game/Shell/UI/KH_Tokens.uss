/* Kestrel Heavy UI tokens (U2). Units are SE points: the shell PanelSettings use
   Scale With Screen Size (375x667 ref, match height), so 1 USS px = 1 pt on SE and scales up on Pro Max / iPad.
   Spacing/touch values come from docs/VISUAL_SPEC.md §5 (sideMarginPt 8, minTouchPt 44).
   Colours: livery defaults from web/js/vehicle/design.js (#f2f2f2 / #1a3c6e) and the noon wash in
   data/tod.json. Art owns final palette/typography (plan §4); change tokens here, not per screen. */

:root {
    --kh-space-1: 4px;
    --kh-space-2: 8px;            /* = sideMarginPt */
    --kh-space-3: 12px;
    --kh-space-4: 16px;
    --kh-space-6: 24px;
    --kh-home-navy: #1e2e48;      /* HomeArt.Navy (mix-v2) */
    --kh-home-cream: #faf0d7;     /* HomeArt.Cream */
    --kh-home-orange: #e88c3c;    /* HomeArt.SunOuter */
    --kh-home-red: #c8102e;
    --kh-home-console: #3c342e;   /* HomeArt.Console */
    --kh-home-lamp-on: #7ee08a;
    --kh-home-lamp-off: #6b5f55;
    --kh-touch-min: 44px;         /* = minTouchPt */
    --kh-radius: 10px;

    --kh-color-ink: #f2f2f2;      /* livery.primary default */
    --kh-color-accent: #1a3c6e;   /* livery.accent default */
    --kh-color-accent-hi: #2a5a8c;/* noon wash.near */
    --kh-color-sky: #6fb4e8;      /* noon wash.horizon */
    --kh-color-space: #010105;    /* noon wash.space */
    --kh-color-panel: rgba(1, 1, 5, 0.62);
    --kh-color-warn: #f6c888;
    --kh-color-danger: #c45a48;

    --kh-font-title: 28px;
    --kh-font-body: 17px;         /* iOS body */
    --kh-font-caption: 13px;
}

.kh-root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0); /* themed fill shows through from the camera */
}

.kh-safe {
    /* position/insets are set from Screen.safeArea + 8 pt by SafeAreaRoot */
    flex-direction: column;
}

.kh-screen {
    flex-grow: 1;
    align-items: stretch;
    justify-content: center;
    padding: var(--kh-space-4);
    max-width: 600px;              /* iPad: keep a readable column, centred; fill stays edge to edge */
    width: 100%;
    align-self: center;
}

.kh-title {
    -unity-font-style: bold;
    font-size: var(--kh-font-title);
    color: var(--kh-color-ink);
    -unity-text-align: middle-center;
    margin-bottom: var(--kh-space-6);
    letter-spacing: 2px;
}

.kh-home { flex-grow: 1; justify-content: flex-start; align-items: center; padding: var(--kh-space-6) var(--kh-space-4) var(--kh-space-6) var(--kh-space-4); }
/* Title and subtitle stretch across the safe column (align-self beats the centered column).
   HomeTitleFit shrinks the 52px wordmark until KESTREL fits that width; the subtitle wraps. */
.kh-home-title { font-size: 52px; -unity-font-style: bold; color: var(--kh-home-cream); -unity-text-align: middle-center; letter-spacing: 4px; margin-top: 32px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(20, 31, 52, 0.8); width: 100%; max-width: 100%; white-space: nowrap; align-self: stretch; }
.kh-home-title-rest { margin-top: 0; color: var(--kh-home-orange); }
.kh-home-subtitle { font-size: 15px; color: var(--kh-home-cream); letter-spacing: 3px; -unity-text-align: middle-center; margin-top: var(--kh-space-2); width: 100%; max-width: 100%; white-space: normal; align-self: stretch; }
.kh-subtitle { font-size: var(--kh-font-body); color: var(--kh-color-ink); -unity-text-align: middle-center; margin-bottom: var(--kh-space-6); }
.kh-button {
    min-height: var(--kh-touch-min);
    min-width: var(--kh-touch-min);
    margin: var(--kh-space-2) 0;
    padding: var(--kh-space-2) var(--kh-space-4);
    border-radius: var(--kh-radius);
    border-width: 0;
    background-color: var(--kh-color-accent);
    color: var(--kh-color-ink);
    font-size: var(--kh-font-body);
    -unity-font-style: bold;
}

/* Retro Home console (mix-v2). Two-class selectors so they outrank .kh-button above. Every target >= 44px. */
.kh-home-callout { font-size: 11px; color: var(--kh-home-cream); letter-spacing: 1px; }
.kh-home-grain { opacity: 0.5; }
.kh-home-console { width: 100%; max-width: 420px; align-self: center; background-color: var(--kh-home-console); border-top-width: 3px; border-top-color: var(--kh-home-orange); border-radius: var(--kh-radius); padding: var(--kh-space-3); margin-bottom: var(--kh-space-2); }
.kh-home-console-row { flex-direction: row; align-items: center; margin-bottom: var(--kh-space-3); }
.kh-home-patch { width: 76px; height: 76px; min-width: 76px; margin-right: var(--kh-space-3); justify-content: flex-end; align-items: center; }
.kh-home-patch-label { font-size: 11px; -unity-font-style: bold; color: var(--kh-home-cream); margin-bottom: 8px; }
.kh-button.kh-home-launch { flex-grow: 1; height: 72px; min-height: 72px; font-size: 28px; -unity-font-style: bold; letter-spacing: 4px; background-color: var(--kh-home-red); color: #ffffff; border-width: 3px; border-color: var(--kh-home-cream); border-radius: var(--kh-radius); }
.kh-home-console-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.kh-button.kh-home-console-button { width: 48.5%; height: 52px; min-height: 52px; margin-bottom: var(--kh-space-2); flex-direction: row; align-items: center; justify-content: center; font-size: 15px; -unity-font-style: bold; letter-spacing: 2px; background-color: var(--kh-home-navy); color: var(--kh-home-cream); border-width: 1px; border-color: rgba(250, 240, 215, 0.4); }
.kh-button.kh-home-console-button:disabled { opacity: 0.55; }
.kh-home-lamp { width: 10px; height: 10px; border-radius: 5px; margin-right: var(--kh-space-2); }
.kh-home-lamp--on { background-color: var(--kh-home-lamp-on); }
.kh-home-lamp--off { background-color: var(--kh-home-lamp-off); }


.kh-button:hover { background-color: var(--kh-color-accent-hi); }
.kh-button:active { background-color: var(--kh-color-accent-hi); scale: 0.98 0.98; }
.kh-button:focus { border-width: 2px; border-color: var(--kh-color-sky); }

.kh-panel {
    background-color: var(--kh-color-panel);
    border-radius: var(--kh-radius);
    padding: var(--kh-space-3);
}

.kh-caption { font-size: var(--kh-font-caption); color: var(--kh-color-ink); opacity: 0.8; }
