/* Portrait-first. Panel scales with screen width (PanelSettings: ScaleWithScreenSize, match width). */
.root { flex-grow: 1; justify-content: flex-end; }
.panel { background-color: rgba(8, 12, 20, 0.88); padding: 24px; border-top-left-radius: 18px; border-top-right-radius: 18px; }
.design-toggle { flex-direction: row; -unity-text-align: middle-left; font-size: 30px; -unity-font-style: bold; color: rgb(255, 176, 0); background-color: rgba(0, 0, 0, 0); border-width: 0; margin: 0; padding: 0 8px; } /* height 56 pt (min 44), set from code */
.design.collapsed .design-body { display: none; }
.design.collapsed { padding-top: 0; }
.title { font-size: 34px; color: rgb(255, 176, 0); -unity-font-style: bold; margin-bottom: 12px; }
.row { margin-top: 8px; margin-bottom: 8px; font-size: 26px; color: white; }
.explode { min-height: 44px; }
.row Label { color: white; font-size: 26px; min-width: 300px; }
.readout { margin-top: 12px; margin-bottom: 16px; }
.readout Label { font-size: 28px; color: rgb(200, 220, 255); }
.readout .big { font-size: 44px; color: white; -unity-font-style: bold; }
.launch { height: 96px; font-size: 32px; -unity-font-style: bold; background-color: rgb(200, 16, 46); color: white; border-width: 0; border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; }
.hud { position: absolute; left: 0; right: 0; top: 0; bottom: 0; padding: 24px; justify-content: flex-start; } /* safe-area padding set from code (HudLayout) */
.hud-band { flex-shrink: 0; }
.hud-spacer { flex-grow: 1; }
.hud-top { flex-direction: row; justify-content: space-between; }
.hud-big { font-size: 56px; color: white; -unity-font-style: bold; }
.hud-chip { font-size: 30px; color: black; background-color: rgb(255, 176, 0); padding: 6px 14px; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; }
.hud-grid { margin-top: 10px; flex-direction: row; flex-wrap: wrap; flex-shrink: 0; background-color: rgba(0, 0, 0, 0.55); padding: 12px; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; }
.hud-cell { width: 33.3%; flex-grow: 0; flex-shrink: 0; font-size: 28px; white-space: nowrap; color: rgb(180, 255, 200); margin-top: 4px; margin-bottom: 4px; }
.hud-cell.q-hot { color: rgb(255, 176, 0); }
.hud-cell.q-crit { color: rgb(255, 138, 106); }
.hud-msg { font-size: 36px; color: rgb(255, 176, 0); -unity-text-align: middle-center; }
.webcast { flex-shrink: 0; background-color: rgba(8, 14, 24, 0.32); padding: 6px 8px; margin-bottom: 8px; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; }
.webcast-verdict { font-size: 22px; color: rgb(255, 176, 0); -unity-font-style: bold; white-space: normal; }
.webcast-pulse { font-size: 16px; color: rgb(210, 230, 220); white-space: normal; margin-top: 2px; }
.flight-help { display: none; }
.hud.hud-info .flight-help { display: flex; flex-direction: column; }
.webcast-seq { flex-direction: row; flex-wrap: wrap; margin-top: 8px; }
.webcast-chip { font-size: 20px; color: white; background-color: rgba(255, 255, 255, 0.14); margin-right: 6px; margin-top: 6px; padding: 6px 10px; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; }
.webcast-now { background-color: rgb(255, 176, 0); color: black; -unity-font-style: bold; }
.webcast-past { color: rgba(255, 255, 255, 0.55); }
.webcast-pin { border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: white; border-right-color: white; border-top-color: white; border-bottom-color: white; }
.webcast-skip { font-size: 22px; margin-top: 8px; color: white; background-color: rgba(255, 255, 255, 0.16); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; }
.home-button { position: absolute; -unity-font-style: bold; color: white; background-color: rgba(8, 12, 20, 0.80); border-width: 0; margin: 0; } /* size, padding, radius in points: SliceApp.HomeButtonMetrics */
.hidden { display: none; }
/* U1 designer validation (DESIGNER_SPEC §6). Static rings, no pulse (Reduce Motion / Reduce Flashing safe). */
.issue-chip { align-self: flex-start; font-size: 26px; -unity-font-style: bold; color: white; background-color: rgb(200, 40, 40); padding: 6px 16px; margin-bottom: 8px; border-top-left-radius: 22px; border-top-right-radius: 22px; border-bottom-left-radius: 22px; border-bottom-right-radius: 22px; }
.issue-chip.warn-only { background-color: rgb(255, 176, 0); color: rgb(20, 20, 30); }
.issue-block { border-width: 4px; border-color: rgb(230, 60, 60); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; }
.issue-warn { border-width: 4px; border-color: rgb(255, 176, 0); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; }
.launch:disabled { background-color: rgb(90, 90, 100); color: rgb(210, 210, 220); }
.launch-reason { font-size: 26px; color: rgb(255, 200, 200); white-space: normal; margin-top: 8px; }
/* Hangar (G3). Sizes in points are set from code (HangarUi); these are colours and flow only. */
.launch-row { flex-direction: row; flex-wrap: wrap; align-items: center; overflow: visible; }
.launch-row .launch { flex-grow: 1; flex-shrink: 1; min-width: 88px; white-space: normal; }
.tool { color: white; background-color: rgba(255, 255, 255, 0.10); border-width: 0; -unity-font-style: bold; }
.tool:disabled { color: rgb(120, 125, 140); }
.issue-chip { position: absolute; }
.design.side { position: absolute; right: 0; top: 0; bottom: 0; border-top-right-radius: 0; border-bottom-left-radius: 18px; }
.design.side.collapsed { bottom: auto; }
.design.collapsed .launch-row { display: none; }
