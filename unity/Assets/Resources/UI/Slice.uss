/* Portrait-first. Panel scales with screen width (PanelSettings: ScaleWithScreenSize, match width). */
.root { flex-grow: 1; justify-content: flex-end; }
.panel { background-color: rgba(8, 12, 20, 0.88); padding: 24px; border-top-left-radius: 18px; border-top-right-radius: 18px; }
.design-toggle { flex-direction: row; -unity-text-align: middle-left; font-size: 30px; -unity-font-style: bold; color: rgb(255, 176, 0); background-color: rgba(0, 0, 0, 0); border-width: 0; margin: 0; padding: 0 8px; } /* height 56 pt (min 44), set from code */
.design.collapsed .design-body { display: none; }
.design.collapsed { padding-top: 0; }
.title { font-size: 34px; color: rgb(255, 176, 0); -unity-font-style: bold; margin-bottom: 12px; }
.row { margin-top: 8px; margin-bottom: 8px; font-size: 26px; color: white; }
.explode { min-height: 44px; }
.row Label { color: white; font-size: 26px; min-width: 300px; }
.readout { margin-top: 12px; margin-bottom: 16px; }
.readout Label { font-size: 28px; color: rgb(200, 220, 255); }
.readout .big { font-size: 44px; color: white; -unity-font-style: bold; }
.launch { height: 96px; font-size: 32px; -unity-font-style: bold; background-color: rgb(200, 16, 46); color: white; border-width: 0; border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; }
.hud { position: absolute; left: 0; right: 0; top: 0; bottom: 0; padding: 24px; justify-content: flex-start; } /* safe-area padding set from code (HudLayout) */
.hud-band { flex-shrink: 0; }
.hud-spacer { flex-grow: 1; }
.hud-top { flex-direction: row; justify-content: space-between; }
.hud-big { font-size: 56px; color: white; -unity-font-style: bold; }
.hud-chip { font-size: 30px; color: black; background-color: rgb(255, 176, 0); padding: 6px 14px; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; }
.hud-grid { margin-top: 10px; flex-direction: row; flex-wrap: wrap; flex-shrink: 0; background-color: rgba(0, 0, 0, 0.55); padding: 12px; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; }
.hud-cell { width: 33.3%; flex-grow: 0; flex-shrink: 0; font-size: 28px; white-space: nowrap; color: rgb(180, 255, 200); margin-top: 4px; margin-bottom: 4px; }
.hud-msg { font-size: 36px; color: rgb(255, 176, 0); -unity-text-align: middle-center; }
.home-button { position: absolute; -unity-font-style: bold; color: white; background-color: rgba(8, 12, 20, 0.80); border-width: 0; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; padding: 0 16px; margin: 0; }
.hidden { display: none; }
