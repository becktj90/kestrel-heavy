/* Dusk post-flight sheet. Type is applied from Resources fonts in ReportCardChrome;
   a USS font url falls back to the default sans on device. The plate is opaque so a
   live HUD cannot show through it. */

.kh-report {
    background-color: rgb(13, 20, 40);
    color: rgb(246, 235, 210);
}

.kh-report .report-actions {
    background-color: rgb(13, 20, 40);
}
