<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS0162;CS0168;CS0219;CS0414;CS0649;CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Same sources as unity/dotnet/Kestrel.Core (linked, not copied); obj/bin stay in this scratch dir. -->
    <Compile Include="../../../../unity/Assets/Kestrel.Core/**/*.cs" LinkBase="Kestrel.Core" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
