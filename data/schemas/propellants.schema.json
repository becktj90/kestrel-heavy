{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kestrel Heavy propellant catalog",
  "type": "object",
  "required": ["version", "propellants"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "propellants": { "type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["id", "label", "fuel", "oxidizer", "fuelDensity", "oxDensity", "mixtureRatio", "bulkDensity", "ispSL", "ispVac", "ispVacMax", "storability", "boiloffPerHour", "costPerKg", "handling"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "label": { "type": "string" },
        "fuel": { "type": "string" }, "oxidizer": { "type": "string" },
        "fuelDensity": { "type": "number", "exclusiveMinimum": 0, "description": "kg/m^3" },
        "oxDensity": { "type": "number", "exclusiveMinimum": 0, "description": "kg/m^3" },
        "mixtureRatio": { "type": ["number", "null"], "description": "O/F by mass; null for solids" },
        "bulkDensity": { "type": "number", "exclusiveMinimum": 0, "description": "kg/m^3 at mixture ratio" },
        "ispSL": { "type": "number", "exclusiveMinimum": 0, "description": "s" },
        "ispVac": { "type": "number", "exclusiveMinimum": 0, "description": "s" },
        "ispVacMax": { "type": "number", "exclusiveMinimum": 0, "description": "s, best vacuum nozzle" },
        "storability": { "enum": ["cryogenic", "deep-cryogenic", "storable", "solid"] },
        "boiloffPerHour": { "type": "number", "minimum": 0 },
        "costPerKg": { "type": "number", "minimum": 0, "description": "USD per kg loaded" },
        "handling": { "type": "array", "items": { "type": "string" } }
      } } }
  }
}
