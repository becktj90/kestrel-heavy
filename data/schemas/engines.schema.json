{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kestrel Heavy engine archetype catalog (generic names only)",
  "type": "object",
  "required": ["version", "cycles", "engines"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "cycles": { "type": "array", "items": { "type": "string" } },
    "engines": { "type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["id", "label", "cycle", "propellant", "thrustSL", "thrustVac", "ispSL", "ispVac", "mass", "pc", "pcMin", "pcRated", "epsMin", "epsMax", "cycleMassFactor", "throttle", "restart", "restarts", "gimbal", "cost", "reliability", "expansionRatio", "diameter"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "label": { "type": "string" },
        "cycle": { "enum": ["gas-generator", "staged-combustion", "full-flow", "expander", "pressure-fed", "solid", "hybrid"] },
        "propellant": { "type": "string", "description": "propellants.json id" },
        "thrustSL": { "type": "number", "minimum": 0, "description": "N; 0 for vacuum-only" },
        "thrustVac": { "type": "number", "exclusiveMinimum": 0, "description": "N" },
        "ispSL": { "type": "number", "minimum": 0, "description": "s" },
        "ispVac": { "type": "number", "exclusiveMinimum": 0, "description": "s" },
        "mass": { "type": "number", "minimum": 0, "description": "kg (0 for solids: casing in stage dry mass)" },
        "pc": { "type": "number", "exclusiveMinimum": 0, "description": "chamber pressure, bar (Isp and thrust reference)" },
        "pcMin": { "type": "number", "exclusiveMinimum": 0, "description": "lowest selectable chamber pressure, bar" },
        "pcRated": { "type": "number", "exclusiveMinimum": 0, "description": "rated chamber pressure, bar. Player pc tops out at pcRated×1.15" },
        "epsMin": { "type": "number", "exclusiveMinimum": 0, "description": "lowest selectable expansion ratio" },
        "epsMax": { "type": "number", "exclusiveMinimum": 0, "description": "highest selectable expansion ratio (vacuum bells reach 250, or the catalog bell if it is wider)" },
        "cycleMassFactor": { "type": "number", "exclusiveMinimum": 0, "description": "k_cycle: pressure-fed 0.8, gas-generator 1, expander 1.05, staged-combustion 1.15, full-flow 1.25; solid and hybrid 1" },
        "throttle": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "exclusiveMinimum": 0 } },
        "restart": { "type": "boolean" }, "restarts": { "type": "integer", "minimum": 0 },
        "gimbal": { "type": "number", "minimum": 0, "description": "deg" },
        "cost": { "type": "number", "minimum": 0, "description": "USD per unit (legacy; E1 cost model derives prices)" },
        "reliability": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "expansionRatio": { "type": "number", "exclusiveMinimum": 0 },
        "diameter": { "type": "number", "exclusiveMinimum": 0, "description": "nozzle exit, m" },
        "note": { "type": "string" },
        "nozzles": {
          "type": "array",
          "description": "Optional discrete catalog bells. The engine's top-level values are the default when the stage omits nozzle or selects the default id. Sea-level and vacuum engines stay separate ids.",
          "items": {
            "type": "object",
            "required": ["id", "expansionRatio", "ispSL", "ispVac", "thrustSL", "thrustVac", "mass", "exitDiameter"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "expansionRatio": { "type": "number", "exclusiveMinimum": 0 },
              "ispSL": { "type": "number", "minimum": 0 },
              "ispVac": { "type": "number", "exclusiveMinimum": 0 },
              "thrustSL": { "type": "number", "minimum": 0 },
              "thrustVac": { "type": "number", "exclusiveMinimum": 0 },
              "mass": { "type": "number", "minimum": 0 },
              "exitDiameter": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      } } }
  }
}
