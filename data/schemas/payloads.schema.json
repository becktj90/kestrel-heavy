{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kestrel Heavy payload archetypes and target orbits",
  "type": "object",
  "required": ["version", "orbits", "payloads"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "orbits": { "type": "object", "additionalProperties": {
      "type": "object", "required": ["id", "label", "apoKm", "periKm", "incDeg"], "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "apoKm": { "type": "number" }, "periKm": { "type": "number" }, "incDeg": { "type": "number" } } } },
    "payloads": { "type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["id", "displayName", "label", "mass", "volume", "diameter", "maxG", "maxHeatFlux", "orbit"], "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "displayName": { "type": "string", "description": "Fictional KH-n name. UI strings key descriptions by id." },
        "label": { "type": "string" },
        "mass": { "type": "number", "exclusiveMinimum": 0 },
        "volume": { "type": "number", "exclusiveMinimum": 0, "description": "m³" },
        "diameter": { "type": "number", "exclusiveMinimum": 0, "description": "m, largest cross-section. Fit needs diameter + 0.2 m ≤ fairing diameter (§2.9)." },
        "maxG": { "type": "number", "exclusiveMinimum": 0 }, "maxHeatFlux": { "type": "number", "exclusiveMinimum": 0 },
        "orbit": { "type": "string", "description": "key of orbits" },
        "crewed": { "type": "boolean" }, "needsAbort": { "type": "boolean" }
      } } }
  }
}
