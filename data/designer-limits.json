{
  "version": 1,
  "note": "Every designer range, step, enum and threshold. Validate and the hangar UI read this file. designer.layers stays in data/params.json because Params/Registry only reads the layer names. The numbers that used to live in the params designer block are here, unchanged.",
  "stages": { "min": 1, "max": 5 },
  "engineCount": { "min": 1, "max": 40, "step": 1 },
  "diameterM": { "min": 0.3, "max": 15, "step": 0.1 },
  "strapOnCounts": [0, 2, 4],
  "safetyFactor": { "min": 1.0, "max": 3.0, "step": 0.05 },
  "tunePct": { "limit": 15, "min": -15, "max": 15, "step": 1 },
  "fairingLengthM": { "min": 1, "max": 40, "step": 0.1 },
  "fairingDiameterM": { "minExclusive": 0 },
  "jettisonAltitudeKm": { "min": 80, "max": 150, "default": 110 },
  "payloadMassKg": { "min": 10, "max": 100000 },
  "propMassKg": { "min": 1, "max": 4000000 },
  "fins": { "countMin": 3, "countMax": 8, "spanMinM": 0.2, "spanMaxM": 6, "spanStepM": 0.1 },
  "landingReserveFraction": { "min": 0, "max": 0.3 },
  "twr": { "min": 1.0, "good": 1.25 },
  "margin": { "min": 0.05 },
  "pack": 1.1,
  "topHeavyRatio": 1.6,
  "fairingNarrowRatio": 0.5,
  "fairingFlare": {
    "note": "Fairing joint and flare (DECISIONS #71, VEHICLE_ENGINEERING_RULES 'Fairing joint and flare'). The fairing base is the top stage diameter at the joint; fairing.diameter is the barrel. A conical shoulder of half angle shoulderAngleDeg joins them, carved from the fairing cylinder and never longer than shoulderMaxCylFraction of it. The fairing-flare WARNING (never a block) fires when barrel / top stage diameter is over warnRatio, or the shoulder half angle is over warnAngleDeg. Render and advice only: no mass, Cd, fit or flight number reads these.",
    "warnRatio": 1.5,
    "warnAngleDeg": 30,
    "shoulderAngleDeg": 15,
    "shoulderMaxCylFraction": 0.5
  },
  "weakUpperTwrVac": 0.5,
  "weakUpperDvFraction": 0.2,
  "heavyFairingKg": 500,
  "stabilityCal": { "aimMin": 1, "aimMax": 2, "overstableAbove": 4 },
  "maxQKPa": { "warnAbove": 45 },
  "interstage": {
    "lengthOverDiameter": 0.6,
    "dragDeltaCd": 0.02,
    "shapes": ["straight", "flare", "shoulder"]
  },
  "arealKgPerM2": { "composite": 14, "al-li": 20, "steel": 45, "al-cu": 22, "titanium": 18, "glass-phenolic": 16, "default": 20 },
  "avionicsTiers": ["basic", "standard", "redundant"],
  "noseCd": { "ogive": 0.3, "conic": 0.36, "blunt": 0.5, "von-karman": 0.28 },
  "cluster": {
    "note": "Count stays engineCount. Absent pattern means auto. minDiameterOverExit is the bounding-circle diameter in engine-exit diameters. custom and auto use the pack fit rule only.",
    "patterns": [
      { "id": "single", "count": 1, "minDiameterOverExit": 1.0 },
      { "id": "row2", "count": 2, "minDiameterOverExit": 2.0 },
      { "id": "row3", "count": 3, "minDiameterOverExit": 3.0 },
      { "id": "ring7", "count": 7, "minDiameterOverExit": 3.0 },
      { "id": "r1p8", "count": 9, "minDiameterOverExit": 3.61 },
      { "id": "r3p9", "count": 12, "minDiameterOverExit": 4.15 },
      { "id": "r3p10p20", "count": 33, "minDiameterOverExit": 7.39 },
      { "id": "custom", "countMin": 1, "countMax": 40 },
      { "id": "auto", "countMin": 1, "countMax": 40 }
    ]
  },
  "v3": {
    "note": "Designer v3 ranges from DESIGNER_V3_SPEC §2.1, §2.4, §2.8 and §2.9. The historical keys above stay as they are: strapOnCounts is still [0, 2, 4] and landingReserveFraction.max is still 0.3. Hangar reads those. v3 consumers read this block.",
    "mixtureOffsetPct": { "min": -10, "max": 10, "step": 1, "hazardAbs": 6, "ispPenaltyPerPct": 0.006 },
    "engine": {
      "expansionRatio": { "min": 8, "max": 120, "vacuumMax": 250 },
      "overpressureAboveRated": 1.15,
      "deepThrottleBelow": 0.4,
      "gimbalDeg": { "min": 0, "note": "max is that engine's catalog gimbal" }
    },
    "tank": {
      "pressureBar": { "min": 1.5, "max": 6 },
      "insulation": ["none", "foam", "mli"],
      "insulationBoiloff": { "none": 1, "foam": 0.4, "mli": 0.15 },
      "insulationKgPerM2": { "none": 0, "foam": 1.2, "mli": 2.5 },
      "commonBulkheadMassFactor": 0.92,
      "commonBulkheadHazardDeltaPBar": 2
    },
    "sepMode": ["cold", "hot", "springs"],
    "separation": { "minRelSpeedMps": 0.5, "qKPaTerm": 0.02 },
    "boosterSepPct": { "min": 0, "max": 100, "note": "absent means separate at burnout" },
    "strapOnCounts": [0, 2, 3, 4, 6, 8],
    "fins": {
      "planforms": ["trapezoid", "clipped-delta", "swept", "square-lattice", "diamond-lattice"],
      "rootChordMinM": 0.1,
      "rootChordMaxM": 6,
      "rootChordStepM": 0.1
    },
    "gridFinDeployAltM": { "min": 0, "max": 120000 },
    "legs": { "kinds": ["light", "heavy"], "lightTouchdownMps": 2, "heavyTouchdownMps": 4, "lightDryFraction": 0.06, "heavyDryFraction": 0.09 },
    "recovery": { "modes": ["expendable", "rtls", "barge"] },
    "landingReserveFraction": { "min": 0, "max": 0.2 },
    "guidance": {
      "pitchKickAltM": { "min": 0, "max": 50000 },
      "pitchKickDeg": { "min": 0, "max": 30 },
      "turnShape": { "min": 0, "max": 1 },
      "maxQThrottlePct": { "min": 0, "max": 100 },
      "gLimit": { "min": 1, "max": 12 }
    },
    "payloadFit": { "radiusFactor": 0.45, "lengthFactor": 0.8, "diameterFactor": 0.9 }
  }
}
